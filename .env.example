GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-3.8-flash
# Supabase Auth (Project Settings → API). Publishable/anon key is public by design; NEVER put the service_role/secret key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=paste_publishable_or_anon_key_here
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"  (placeholder/short values are ignored)
FLASK_SECRET_KEY=change_me_to_any_long_random_string
# Billing guard: max real Gemini calls per server instance per UTC day (then offline mode). AI_DISABLED=1 = kill switch.
AI_DAILY_LIMIT=200
AI_DISABLED=0
# Daily cron (/cron/daily). Vercel sends it as a Bearer token. Generate like FLASK_SECRET_KEY (16+ chars).
CRON_SECRET=change_me_to_a_long_random_string
# Admin (moderation, takedown contact on /terms). Your @bmsce.ac.in address.
ADMIN_EMAIL=you@bmsce.ac.in
